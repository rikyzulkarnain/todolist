NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_GEN_AI_API_KEY=

# Web Push (opsional) — hanya untuk notifikasi saat app tertutup via Edge
# Function send-reminders. Buat pasangan kunci: npx web-push generate-vapid-keys
# Kunci PUBLIC di sini; kunci PRIVATE disimpan sebagai secret Supabase.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Telegram (opsional, v3) — bot token dari @BotFather. Juga di-set sebagai
# secret Supabase untuk Edge Function telegram-webhook.
TELEGRAM_BOT_TOKEN=

# Google Calendar (opsional, v3) — OAuth dari Google Cloud Console.
# Client ID boleh publik; Client Secret rahasia (server-only).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Base URL app (untuk redirect OAuth di produksi), mis. https://app.contoh.com
NEXT_PUBLIC_APP_URL=
